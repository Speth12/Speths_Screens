{
  "schemaVersion": 7,
  "version": "1.1.0",
  "name": "PLC Demo",
  "theme": {
    "preset": "clean"
  },
  "shell": {
    "nav": "sidebar"
  },
  "canvasSnap": "pixel",
  "canvasResolution": {
    "type": "dynamic"
  },
  "datasources": [
    {
      "id": "opcua",
      "type": "opcua",
      "label": "PLC OPC UA",
      "config": {
        "endpoint": "opc.tcp://10.0.0.210:4840",
        "securityMode": "SignAndEncrypt",
        "securityPolicy": "Basic256Sha256",
        "certCheck": "pinned",
        "certFingerprint": ""
      }
    },
    {
      "id": "rest",
      "type": "rest",
      "label": "PLC REST",
      "config": {
        "endpoint": "https://10.0.0.210",
        "basePath": "/_pxc_api/v1.14",
        "certCheck": "pinned",
        "certFingerprint": ""
      }
    },
    {
      "id": "mem",
      "type": "memory",
      "label": "Script state",
      "config": {
        "memoryTags": [
          {
            "path": "Counter",
            "type": "int",
            "initial": 0
          },
          {
            "path": "Target",
            "type": "int",
            "initial": 10
          },
          {
            "path": "Step",
            "type": "int",
            "initial": 100
          },
          {
            "path": "RuleState",
            "type": "string",
            "initial": "Click the button to count"
          },
          {
            "path": "Fired",
            "type": "int",
            "initial": 0
          },
          {
            "path": "LastFired",
            "type": "string",
            "initial": "never"
          },
          {
            "path": "CarryEnable",
            "type": "bool",
            "initial": false
          },
          {
            "path": "Carried",
            "type": "int",
            "initial": 0
          }
        ]
      }
    }
  ],
  "alarmRules": [
    {
      "id": "a-input",
      "name": "The PLC's reply is above 200",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write} > 200",
      "severity": "warning",
      "message": "iOPC_Write is above 200"
    },
    {
      "id": "a-temp",
      "name": "High temperature",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/HMI_SIM_Temp} > 100",
      "severity": "warning",
      "message": "HMI_SIM_Temp above 100"
    },
    {
      "id": "a-acted",
      "name": "The script acted",
      "expr": "{mem:Fired} > 0",
      "severity": "info",
      "message": "The increment script has written to the PLC's input"
    }
  ],
  "scripts": [
    {
      "id": "counter-rule",
      "name": "Add to the PLC's input when the counter reaches the target",
      "trigger": {
        "onChange": [
          "mem:Counter"
        ]
      },
      "writes": [
        "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read",
        "mem:Counter",
        "mem:RuleState",
        "mem:Fired",
        "mem:LastFired"
      ],
      "source": "const COUNT = 'mem:Counter', INPUT = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read\";\nconst n = readTag(COUNT);\nif (typeof n !== 'number') return;\nconst target = readTag('mem:Target') ?? 10, step = readTag('mem:Step') ?? 100;\nconst say = async (text) => { if (state.text !== text) { state.text = text; await writeTag('mem:RuleState', text); } };\nif (n < target) { const left = target - n; await say(left + (left === 1 ? ' more click' : ' more clicks') + ' to go'); return; }\nif (state.busy) return;\nstate.busy = true;\ntry {\n  const current = readTag(INPUT);\n  const next = (typeof current === 'number' ? current : 0) + step;\n  const r = await writeTag(INPUT, next);\n  if (r.status !== 'confirmed') { log('write not confirmed:', r.status, r.reason ?? ''); await say('Write failed: ' + (r.reason ?? r.status)); return; }\n  state.fired = (state.fired ?? 0) + 1;\n  await writeTag(COUNT, Math.max(0, readTag(COUNT) - target));\n  await writeTag('mem:Fired', state.fired);\n  await writeTag('mem:LastFired', new Date().toLocaleTimeString() + ': ' + INPUT.split('/').pop() + ' = ' + next);\n  emit('plc.increment', { counted: n, wrote: next, n: state.fired });\n  log('the counter reached', target, ': wrote', next, 'to the PLC input');\n  state.text = undefined;\n} finally {\n  state.busy = false;\n}"
    },
    {
      "id": "carry",
      "name": "Carry the OPC UA reply into the REST input",
      "trigger": {
        "onChange": [
          "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write"
        ]
      },
      "writes": [
        "rest:Arp.Plc.Eclr/iREST_Read",
        "mem:Carried"
      ],
      "source": "const ECHO = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write\", TARGET = \"rest:Arp.Plc.Eclr/iREST_Read\";\nif (!readTag('mem:CarryEnable') || event.quality !== 'Good' || typeof event.value !== 'number') return;\nif (event.value === state.last) return;\nstate.last = event.value;\nconst r = await writeTag(TARGET, Math.round(event.value));\nif (r.status !== 'confirmed') { log('carry not confirmed:', r.status, r.reason ?? ''); return; }\nstate.count = (state.count ?? 0) + 1; // counted before the await, so runs that overlap cannot repeat a number\nawait writeTag('mem:Carried', state.count);"
    }
  ],
