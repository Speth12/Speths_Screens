{
  "schemaVersion": 6,
  "version": "1.1.0",
  "name": "PLC Demo",
  "theme": {
    "preset": "clean"
  },
  "shell": {
    "nav": "sidebar"
  },
  "canvasSnap": "pixel",
  "canvasResolution": {
    "type": "dynamic"
  },
  "datasources": [
    {
      "id": "opcua",
      "type": "opcua",
      "label": "PLC OPC UA",
      "config": {
        "endpoint": "opc.tcp://10.0.0.210:4840",
        "securityMode": "SignAndEncrypt",
        "securityPolicy": "Basic256Sha256",
        "certCheck": "pinned",
        "certFingerprint": ""
      }
    },
    {
      "id": "rest",
      "type": "rest",
      "label": "PLC REST",
      "config": {
        "endpoint": "https://10.0.0.210",
        "basePath": "/_pxc_api/v1.14",
        "certCheck": "pinned",
        "certFingerprint": ""
      }
    },
    {
      "id": "mem",
      "type": "memory",
      "label": "Script state",
      "config": {
        "memoryTags": [
          {
            "path": "RuleEnable",
            "type": "bool",
            "initial": false
          },
          {
            "path": "Threshold",
            "type": "real",
            "initial": 100
          },
          {
            "path": "WaitSeconds",
            "type": "int",
            "initial": 5
          },
          {
            "path": "Step",
            "type": "int",
            "initial": 100
          },
          {
            "path": "RuleState",
            "type": "string",
            "initial": "Switched off"
          },
          {
            "path": "Countdown",
            "type": "int",
            "initial": 0
          },
          {
            "path": "Fired",
            "type": "int",
            "initial": 0
          },
          {
            "path": "LastFired",
            "type": "string",
            "initial": "never"
          },
          {
            "path": "CarryEnable",
            "type": "bool",
            "initial": false
          },
          {
            "path": "Carried",
            "type": "int",
            "initial": 0
          }
        ]
      }
    }
  ],
  "alarmRules": [
    {
      "id": "a-input",
      "name": "The PLC's reply is above the limit",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write} > {mem:Threshold}",
      "severity": "warning",
      "message": "iOPC_Write is above the limit"
    },
    {
      "id": "a-temp",
      "name": "High temperature",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/HMI_SIM_Temp} > 100",
      "severity": "warning",
      "message": "HMI_SIM_Temp above 100"
    },
    {
      "id": "a-acted",
      "name": "The script acted",
      "expr": "{mem:Fired} > 0",
      "severity": "info",
      "message": "The increment script has written to the PLC's input"
    }
  ],
  "scripts": [
    {
      "id": "increment-rule",
      "name": "Add to the PLC's input while its reply stays high",
      "trigger": {
        "every": 250
      },
      "writes": [
        "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read",
        "mem:RuleState",
        "mem:Countdown",
        "mem:Fired",
        "mem:LastFired"
      ],
      "source": "if (state.busy) return;\nstate.busy = true;\ntry {\n  const ECHO = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write\", INPUT = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read\";\n  const set = async (text, left) => {\n    if (state.text !== text) { state.text = text; await writeTag('mem:RuleState', text); }\n    if (state.left !== left) { state.left = left; await writeTag('mem:Countdown', left); }\n  };\n  if (!readTag('mem:RuleEnable')) { state.since = undefined; state.done = false; await set('Switched off', 0); return; }\n  const value = readTag(ECHO);\n  if (quality(ECHO) !== 'Good' || typeof value !== 'number') { state.since = undefined; await set('Waiting for the PLC', 0); return; }\n  const limit = readTag('mem:Threshold') ?? 100;\n  const wait = (readTag('mem:WaitSeconds') ?? 5) * 1000;\n  if (value <= limit) { state.since = undefined; state.done = false; await set('The PLC reports a value at or below the limit', 0); return; }\n  state.since ??= Date.now();\n  const left = wait - (Date.now() - state.since);\n  if (left > 0) { await set('Above the limit, waiting', Math.ceil(left / 1000)); return; }\n  if (state.done) { await set('Done: waiting for the value to drop', 0); return; }\n  const current = readTag(INPUT);\n  const next = (typeof current === 'number' ? current : 0) + (readTag('mem:Step') ?? 100);\n  const r = await writeTag(INPUT, next);\n  if (r.status !== 'confirmed') { log('increment not confirmed:', r.status, r.reason ?? ''); await set('Write failed: ' + (r.reason ?? r.status), 0); return; }\n  state.done = true;\n  state.fired = (state.fired ?? 0) + 1;\n  await writeTag('mem:Fired', state.fired);\n  await writeTag('mem:LastFired', new Date().toLocaleTimeString() + ': ' + INPUT.split('/').pop() + ' = ' + next);\n  emit('plc.increment', { value, limit, wrote: next, n: state.fired });\n  log('the PLC reported', value, 'above', limit, 'for', wait / 1000, 's: wrote', next, 'to its input');\n  await set('Done: waiting for the value to drop', 0);\n} finally {\n  state.busy = false;\n}"
    },
    {
      "id": "carry",
      "name": "Carry the OPC UA reply into the REST input",
      "trigger": {
        "onChange": [
          "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write"
        ]
      },
      "writes": [
        "rest:Arp.Plc.Eclr/iREST_Read",
        "mem:Carried"
      ],
      "source": "const ECHO = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write\", TARGET = \"rest:Arp.Plc.Eclr/iREST_Read\";\nif (!readTag('mem:CarryEnable') || event.quality !== 'Good' || typeof event.value !== 'number') return;\nif (event.value === state.last) return;\nstate.last = event.value;\nconst r = await writeTag(TARGET, Math.round(event.value));\nif (r.status !== 'confirmed') { log('carry not confirmed:', r.status, r.reason ?? ''); return; }\nstate.count = (state.count ?? 0) + 1; // counted before the await, so runs that overlap cannot repeat a number\nawait writeTag('mem:Carried', state.count);"
    }
  ],
