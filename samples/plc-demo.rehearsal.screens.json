            "path": "Arp.Plc.Eclr/sREST_Write",
            "type": "string",
            "initial": ""
          }
        ]
      }
    },
    {
      "id": "mem",
      "type": "memory",
      "label": "Script state",
      "config": {
        "memoryTags": [
          {
            "path": "RuleEnable",
            "type": "bool",
            "initial": false
          },
          {
            "path": "Threshold",
            "type": "real",
            "initial": 100
          },
          {
            "path": "WaitSeconds",
            "type": "int",
            "initial": 5
          },
          {
            "path": "Step",
            "type": "int",
            "initial": 100
          },
          {
            "path": "RuleState",
            "type": "string",
            "initial": "Switched off"
          },
          {
            "path": "Countdown",
            "type": "int",
            "initial": 0
          },
          {
            "path": "Fired",
            "type": "int",
            "initial": 0
          },
          {
            "path": "LastFired",
            "type": "string",
            "initial": "never"
          },
          {
            "path": "MirrorEnable",
            "type": "bool",
            "initial": false
          },
          {
            "path": "Mirrored",
            "type": "int",
            "initial": 0
          }
        ]
      }
    }
  ],
  "alarmRules": [
    {
      "id": "a-input",
      "name": "Input above the limit",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read} > {mem:Threshold}",
      "severity": "warning",
      "message": "iOPC_Read is above the limit"
    },
    {
      "id": "a-temp",
      "name": "High temperature",
      "expr": "{opcua:ns=6;s=Arp.Plc.Eclr/HMI_SIM_Temp} > 100",
      "severity": "warning",
      "message": "HMI_SIM_Temp above 100"
    },
    {
      "id": "a-acted",
      "name": "The script acted",
      "expr": "{mem:Fired} > 0",
      "severity": "info",
      "message": "The increment script has written to iOPC_Write"
    }
  ],
  "scripts": [
    {
      "id": "increment-rule",
      "name": "Increment when the input stays high",
      "trigger": {
        "every": 250
      },
      "writes": [
        "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write",
        "mem:RuleState",
        "mem:Countdown",
        "mem:Fired",
        "mem:LastFired"
      ],
      "source": "const IN = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read\", OUT = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Write\";\nconst set = async (text, left) => {\n  if (state.text !== text) { state.text = text; await writeTag('mem:RuleState', text); }\n  if (state.left !== left) { state.left = left; await writeTag('mem:Countdown', left); }\n};\nif (!readTag('mem:RuleEnable')) { state.since = undefined; state.done = false; await set('Switched off', 0); return; }\nconst value = readTag(IN);\nif (quality(IN) !== 'Good' || typeof value !== 'number') { state.since = undefined; await set('Waiting for the PLC', 0); return; }\nconst limit = readTag('mem:Threshold') ?? 100;\nconst wait = (readTag('mem:WaitSeconds') ?? 5) * 1000;\nif (value <= limit) { state.since = undefined; state.done = false; await set('Input at or below the limit', 0); return; }\nstate.since ??= Date.now();\nconst left = wait - (Date.now() - state.since);\nif (left > 0) { await set('Input above the limit, waiting', Math.ceil(left / 1000)); return; }\nif (state.done) { await set('Done: waiting for the input to drop', 0); return; }\nconst current = readTag(OUT);\nconst next = (typeof current === 'number' ? current : 0) + (readTag('mem:Step') ?? 100);\nconst r = await writeTag(OUT, next);\nif (r.status !== 'confirmed') { log('increment not confirmed:', r.status, r.reason ?? ''); await set('Write failed: ' + (r.reason ?? r.status), 0); return; }\nstate.done = true;\nconst n = (readTag('mem:Fired') ?? 0) + 1;\nawait writeTag('mem:Fired', n);\nawait writeTag('mem:LastFired', new Date().toLocaleTimeString() + ': ' + OUT.split('/').pop() + ' = ' + next);\nemit('plc.increment', { value, limit, wrote: next, n });\nlog('input', value, 'was above', limit, 'for', wait / 1000, 's: wrote', next);\nawait set('Done: waiting for the input to drop', 0);"
    },
    {
      "id": "mirror",
      "name": "Mirror the OPC read-in to REST",
      "trigger": {
        "onChange": [
          "opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read"
        ]
      },
      "writes": [
        "rest:Arp.Plc.Eclr/iREST_Write",
        "mem:Mirrored"
      ],
      "source": "const IN = \"opcua:ns=6;s=Arp.Plc.Eclr/iOPC_Read\", OUT = \"rest:Arp.Plc.Eclr/iREST_Write\";\nif (!readTag('mem:MirrorEnable') || event.quality !== 'Good' || typeof event.value !== 'number') return;\nif (event.value === state.last) return;\nstate.last = event.value;\nconst r = await writeTag(OUT, Math.round(event.value));\nif (r.status !== 'confirmed') { log('mirror not confirmed:', r.status, r.reason ?? ''); return; }\nawait writeTag('mem:Mirrored', (readTag('mem:Mirrored') ?? 0) + 1);"
    }
  ],
