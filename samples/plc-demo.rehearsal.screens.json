  },
  "shell": {
    "nav": "sidebar"
  },
  "canvasSnap": "pixel",
  "canvasResolution": {
    "type": "dynamic"
  },
  "datasources": [
    {
      "id": "opcua",
      "type": "memory",
      "label": "PLC OPC UA (rehearsal)",
      "config": {
        "memoryTags": [
          {
            "path": "ns=6;s=Arp.Plc.Eclr/iOPC_Read",
            "type": "int",
            "initial": 0
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/rOPC_Read",
            "type": "real",
            "initial": 0
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/sOPC_Read",
            "type": "string",
            "initial": ""
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/HMI_SIM_Temp",
            "type": "real",
            "initial": 75
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/HMI_SIM_Volt",
            "type": "real",
            "initial": 5
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/rRTD_Fahrenheit",
            "type": "real",
            "initial": 70
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/rVoltage_0_100_Scaled",
            "type": "real",
            "initial": 50
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/iOPC_Write",
            "type": "int",
            "initial": 0
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/rOPC_Write",
            "type": "real",
            "initial": 0
          },
          {
            "path": "ns=6;s=Arp.Plc.Eclr/sOPC_Write",
            "type": "string",
            "initial": ""
          }
        ]
      }
    },
    {
      "id": "rest",
      "type": "memory",
      "label": "PLC REST (rehearsal)",
      "config": {
        "memoryTags": [
          {
            "path": "Arp.Plc.Eclr/iREST_Read",
            "type": "int",
            "initial": 0
          },
          {
            "path": "Arp.Plc.Eclr/rREST_Read",
            "type": "real",
            "initial": 0
          },
          {
            "path": "Arp.Plc.Eclr/sREST_Read",
            "type": "string",
            "initial": ""
          },
          {
            "path": "Arp.Plc.Eclr/iREST_Write",
            "type": "int",
            "initial": 0
          },
          {
            "path": "Arp.Plc.Eclr/rREST_Write",
            "type": "real",
            "initial": 0
          },
