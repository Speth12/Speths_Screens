{
  "schemaVersion": 7,
  "version": "1.0.0",
  "name": "Pump Station 2",
  "theme": {
    "preset": "clean"
  },
  "shell": {
    "nav": "sidebar"
  },
  "canvasSnap": "pixel",
  "canvasResolution": {
    "type": "dynamic"
  },
  "datasources": [
    {
      "id": "sim",
      "type": "virtual",
      "label": "Simulation",
      "config": {
        "tags": [
          {
            "path": "phase",
            "expr": "((good({sim:phase}) ? {sim:phase} : 0) + 0.012) % 6.283"
          },
          {
            "path": "pressure",
            "expr": "62.3 + sin({sim:phase}) * 0.9"
          },
          {
            "path": "flow",
            "expr": "51.7 + sin({sim:phase} * 1.3) * 1.4"
          },
          {
            "path": "level",
            "expr": "66 + sin({sim:phase} * 0.7) * 3"
          },
          {
            "path": "efficiency",
            "expr": "69 + sin({sim:phase} * 0.5) * 1.5"
          },
          {
            "path": "pump_running",
            "expr": "1"
          }
        ]
      }
    }
  ],
  "alarmRules": [
    {
      "id": "a-pressure",
      "name": "High inlet pressure",
      "expr": "{sim:pressure} > 62",
      "severity": "warning",
      "message": "Inlet pressure above 62 bar"
    },
    {
      "id": "a-standby",
      "name": "Pump 2 in standby",
      "expr": "{sim:pump_running} == 1",
      "severity": "info",
      "message": "Pump 2 in standby, auto start enabled"
    },
    {
      "id": "a-calibration",
      "name": "Calibration due",
      "expr": "{sim:pump_running} == 1",
      "severity": "info",
      "message": "Calibration due on flow transmitter FT-101"
    }
  ],
