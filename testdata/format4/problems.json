[
  { "name": "all fine",
    "project": {
      "datasources": [{ "id": "mem", "type": "memory", "label": "Memory", "config": { "memoryTags": [
        { "path": "Count", "type": "int", "initial": 0, "retain": true },
        { "path": "Mode", "type": "string", "initial": "auto" },
        { "path": "Ratio", "type": "real", "initial": 0.5 },
        { "path": "Run", "type": "bool", "initial": false }
      ] } }],
      "alarmRules": [{ "id": "high", "name": "High", "expr": "{mem:Count} > 10", "severity": "info", "message": "m" }],
      "sessionVars": [{ "name": "step", "type": "int", "initial": 1 }, { "name": "Operator_2", "type": "string" }],
      "scriptRole": "supervisor",
      "scripts": [{ "id": "count", "name": "Count", "trigger": { "onChange": ["mem:Run", "ns:Plant/Auto"], "every": 1000, "onStart": true, "onAlarm": ["high"] },
        "source": "const n = readTag('mem:Count');\nif (n > 5) return;\nawait writeTag('mem:Count', n + 1);" }]
    },
    "want": [] },
  { "name": "memory tags",
    "project": { "datasources": [{ "id": "mem", "type": "memory", "label": "Memory", "config": { "memoryTags": [
