      "datasource \"mem\", memory tag Name: initial 3 is not of type string",
      "datasource \"mem\", memory tag Ratio: initial true is not of type real"
    ] },
  { "name": "session variables",
    "project": { "sessionVars": [
      { "name": "step", "type": "int" },
      { "name": "step", "type": "int" },
      { "name": "2nd", "type": "bool" },
      { "name": "my var", "type": "string", "initial": 0 }
