      { "path": "Count", "type": "int" },
      { "path": "Run", "type": "bool", "initial": "yes" },
      { "path": "Name", "type": "string", "initial": 3 },
      { "path": "Ratio", "type": "real", "initial": true }
    ] } }] },
    "want": [
      "datasource \"mem\", memory tag Count: initial 1.5 is not of type int",
      "datasource \"mem\", memory tag Count: the path is used twice",
