    ] },
  { "name": "script triggers",
    "project": {
      "datasources": [{ "id": "plc", "type": "rest", "label": "PLC", "config": {} }],
      "alarmRules": [{ "id": "high", "name": "High", "expr": "{plc:T} > 1", "severity": "info", "message": "m" }],
      "scripts": [
        { "id": "a", "name": "A", "trigger": { "onChange": ["plc:T", "other:X", "nocolon"], "onAlarm": ["high", "low"] }, "source": "log(1)" },
        { "id": "a", "name": "A again", "trigger": { "onStart": true }, "source": "" }
      ] },
    "want": [
      "script \"a\": onChange: other:X names no datasource",
      "script \"a\": onChange: nocolon names no datasource",
      "script \"a\": onAlarm: no alarm rule \"low\"",
      "script \"a\": the id is used twice"
    ] },
  { "name": "session variables only on screens",
    "project": {
      "datasources": [
        { "id": "calc", "type": "virtual", "label": "Calc", "config": { "tags": [{ "path": "Mode", "expr": "{session:shift} + 1" }] } },
        { "id": "session", "type": "memory", "label": "Mine", "config": { "memoryTags": [] } }
      ],
      "alarmRules": [{ "id": "r", "name": "R", "expr": "{calc:Mode} > 1 && {session:shift} == 2", "severity": "info", "message": "m" }],
      "sessionVars": [{ "name": "shift", "type": "int" }],
      "presets": [{ "id": "p", "name": "P", "widgets": [
        { "id": "w1", "type": "led", "x": 0, "y": 0, "w": 1, "h": 1, "dynamics": { "visible": { "expr": "{session:shift} > 1 && {session:nope}" }, "blink": { "expr": "{session:shift} == 3" } } }
      ] }]
    },
    "want": [
      "datasource \"calc\", calculated tag Mode: {session:shift} is a session variable, which only screens have",
      "alarm rule \"r\": {session:shift} is a session variable, which only screens have",
      "datasource \"session\": the id is kept for session variables",
      "preset \"P\", widget w1 (led): dynamics.visible: {session:nope} names no session variable"
    ] },
  { "name": "script write lists",
    "project": {
      "datasources": [
        { "id": "plc", "type": "rest", "label": "PLC", "config": {} },
        { "id": "mem", "type": "memory", "label": "Memory", "config": { "memoryTags": [] } }
      ],
      "scripts": [
        { "id": "ok", "name": "Fine", "trigger": { "onStart": true }, "source": "log(1)", "writes": ["mem:*", "plc:Motor/Start", "ns:Line1/*", "plc:Pump/*"] },
        { "id": "w", "name": "W", "trigger": { "onStart": true }, "source": "log(1)",
          "writes": ["mem:Count", "other:X", "nocolon", "", "mem:a*b", "mem:Count", "*", "plc:Motor/Start*"] }
      ] },
    "want": [
      "script \"w\": writes: other:X names no datasource",
      "script \"w\": writes: nocolon names no datasource",
      "script \"w\": writes: an entry is empty",
      "script \"w\": writes: mem:a*b: * is only allowed as the last character",
      "script \"w\": writes: mem:Count is listed twice",
      "script \"w\": writes: * names no datasource"
    ] }
