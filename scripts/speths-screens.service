[Unit]
Description=Speth's Screens Operator Runtime
After=network.target plcnext.service
Wants=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/plcnext/apps/speths-screens
ExecStart=/opt/plcnext/apps/speths-screens/speths-screens \
    --mode=runtime \
    --addr=:8080 \
    --project=/opt/plcnext/apps/speths-screens/demo.screens.json \
    --history=/opt/plcnext/apps/speths-screens/history.db
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=speths-screens

# Allow binding to port 8080 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
