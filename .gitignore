node_modules/
dist/

# compiled binaries (the bare names are anchored so they never match the cmd/ folder)
/speths-screens
cmd/speths-screens/speths-screens
speths-screens.exe
speths-screens.exe~
speths-screens-*

# generated TLS certs
*.pem

# SQLite
*.db
*.db-shm
*.db-wal

# Project files (user data — mount via volume, don't commit)
project/*.screens.json
project/project.json

# Operator UI embed dir (built by Dockerfile / make build-operator)
cmd/speths-screens/ui/

# logs
*.log

# Vite / tsc build cache
*.tsbuildinfo
packages/ide/vite.config.js

# soak test output (scripts/soak/run-soak.ps1)
soak-runs/

# A panel probe holds the panel's network and hardware addresses: never commit it
scripts/panel/panel-probe*.txt

# The IDE build embedded into programs built with -tags ide (scripts/release/build.mjs)
/cmd/speths-screens/ide/
