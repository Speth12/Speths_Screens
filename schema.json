        "height": { "type": "integer", "minimum": 1, "description": "fixed only" }
      }
    },
    "CanvasResolutionType": {
      "title": "CanvasResolutionType",
      "type": "string",
      "enum": ["dynamic", "fixed"]
    },
    "CanvasSnap": {
      "title": "CanvasSnap",
      "type": "string",
      "enum": ["grid", "pixel"]
    }
  }
