{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "description": "Speth's Screens project file — single source of truth. Generated types: internal/project/types.go + packages/shared-types/src/project.ts",
  "type": "object",
  "required": ["version", "datasources", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version, e.g. '0.1.0'"
    },
    "name": {
      "type": "string",
      "description": "Human-readable project name"
    },
    "pin": {
      "type": "string",
      "description": "Operator PIN — operator panel locks behind this if set"
    },
    "viewOnly": {
      "type": "boolean",
      "description": "Disable all write widgets in the operator panel"
    },
    "theme": {
      "$ref": "#/$defs/ThemeId",
      "description": "Default theme for every screen. A browser can still pick its own; that choice is not saved in the project"
    },
    "security": {
      "$ref": "#/$defs/Security",
      "description": "Login settings. Missing means mode 'none'"
    },
    "users": {
      "type": "array",
      "items": { "$ref": "#/$defs/User" },
      "description": "Users who can log in when security.mode is 'login'"
    },
    "datasources": {
      "type": "array",
      "items": { "$ref": "#/$defs/Datasource" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Page" }
    },
    "alarmRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/AlarmRule" }
    },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Recipe" }
    },
    "namespace": {
      "type": "array",
      "items": { "$ref": "#/$defs/NamespaceNode" },
      "description": "Unified Namespace — flat list of folders, assets and tags. Tags with driverId+driverAddr are bound to a live datasource"
    },
    "faceplates": {
      "type": "array",
      "items": { "$ref": "#/$defs/Faceplate" }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/$defs/ImageAsset" }
    },
    "udts": {
      "type": "array",
      "items": { "$ref": "#/$defs/UDT" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/AssetNode" }
    },
    "canvasResolution": { "$ref": "#/$defs/CanvasResolution" },
    "canvasSnap":       { "$ref": "#/$defs/CanvasSnap" },
    "enabledSymbolPacks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Symbol pack ids shown in the IDE symbol library. Missing means all packs"
    }
  },
  "$defs": {
    "ThemeId": {
      "title": "ThemeId",
      "type": "string",
      "enum": ["scada-dark", "blueprint", "clean-room", "brutalist", "holographic", "engineering-paper"]
    },
    "Security": {
      "title": "Security",
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/AuthMode" }
      }
    },
    "AuthMode": {
      "title": "AuthMode",
      "type": "string",
      "enum": ["none", "login"],
      "description": "none: no login, anyone who reaches the runtime can read and write. login: every user must log in"
    },
    "User": {
      "title": "User",
      "type": "object",
      "required": ["id", "name", "role", "passwordHash"],
      "additionalProperties": false,
      "properties": {
        "id":           { "type": "string" },
        "name":         { "type": "string", "description": "Login name" },
        "role":         { "$ref": "#/$defs/UserRole" },
        "passwordHash": { "type": "string", "description": "bcrypt hash ($2a$/$2b$). Never a plain-text password" }
      }
    },
    "UserRole": {
      "title": "UserRole",
      "type": "string",
      "enum": ["admin", "operator", "viewer"]
    },
    "Datasource": {
      "title": "Datasource",
      "type": "object",
      "required": ["id", "type", "label", "config"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "description": "Unique driver instance ID, e.g. 'opcua', 'mbtcp1'" },
        "type":   { "$ref": "#/$defs/DatasourceType" },
        "label":  { "type": "string" },
        "config": { "$ref": "#/$defs/DatasourceConfig" }
      }
    },
    "DatasourceType": {
      "title": "DatasourceType",
      "type": "string",
      "enum": ["opcua", "mbtcp", "mqtt", "rest", "virtual"]
    },
    "DatasourceConfig": {
      "title": "DatasourceConfig",
      "type": "object",
      "description": "Driver-specific connection config. Fields used depend on 'type'.",
      "additionalProperties": false,
      "properties": {
        "endpoint":      { "type": "string", "description": "OPC UA: opc.tcp://host:port" },
        "securityMode":  { "$ref": "#/$defs/SecurityMode" },
        "securityPolicy":{ "$ref": "#/$defs/SecurityPolicy" },
        "username":      { "type": "string" },
        "password":      { "type": "string" },
        "host":          { "type": "string", "description": "Modbus/MQTT/REST host" },
        "port":          { "type": "integer", "description": "TCP port" },
        "slaveId":       { "type": "integer", "description": "Modbus slave/unit ID" },
        "clientId":      { "type": "string", "description": "MQTT client ID" },
        "basePath":      { "type": "string", "description": "REST base path, e.g. /_pxc_api/v1.14" },
        "bearerToken":   { "type": "string", "description": "REST bearer token" },
        "tags":          { "type": "string", "description": "Virtual driver: JSON-encoded [{path,formula}...] array" }
      }
    },
    "SecurityMode": {
      "title": "SecurityMode",
      "type": "string",
      "enum": ["None", "Sign", "SignAndEncrypt"]
    },
    "SecurityPolicy": {
      "title": "SecurityPolicy",
      "type": "string",
      "enum": ["None", "Basic128Rsa15", "Basic256", "Basic256Sha256"]
    },
    "Page": {
      "title": "Page",
      "type": "object",
      "required": ["id", "name", "widgets"],
      "additionalProperties": false,
      "properties": {
        "id":              { "type": "string" },
        "name":            { "type": "string" },
        "widgets":         { "type": "array", "items": { "$ref": "#/$defs/Widget" } },
        "backgroundColor": { "type": "string", "description": "CSS color for the page background" },
        "script":          { "type": "string", "description": "Page script (JavaScript source)" }
      }
    },
    "Widget": {
      "title": "Widget",
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "id":             { "type": "string" },
        "type":           { "$ref": "#/$defs/WidgetType" },
        "x":              { "type": "integer", "minimum": 0, "description": "Grid column" },
        "y":              { "type": "integer", "minimum": 0, "description": "Grid row" },
        "w":              { "type": "integer", "minimum": 1, "description": "Width in grid units" },
        "h":              { "type": "integer", "minimum": 1, "description": "Height in grid units" },
        "binding":        { "type": "string", "description": "datasource_id:tag_path, e.g. 'opcua:ns=2;s=PLCnext.iTest'" },
        "visibleBinding": { "type": "string", "description": "BOOL tag — widget hidden when value is 0/false" },
        "locked":         { "type": "boolean", "description": "IDE-only: widget cannot be moved or resized" },
        "groupId":        { "type": "string", "description": "IDE-only: widgets with the same groupId move together" },
        "config":         { "$ref": "#/$defs/WidgetConfig" },
        "dynamics":       { "type": "array", "items": { "$ref": "#/$defs/Dynamic" } }
      }
    },
    "WidgetType": {
      "title": "WidgetType",
      "type": "string",
      "enum": [
        "gauge",
        "trend",
        "led",
        "button",
        "numericInput",
        "numericDisplay",
        "textInput",
        "textDisplay",
        "historyLog",
        "tank",
        "setpoint",
        "multiState",
        "alarmBanner",
        "image",
        "symbol",
        "faceplate",
        "table"
      ]
    },
    "WidgetConfig": {
      "title": "WidgetConfig",
      "type": "object",
      "description": "Per-widget configuration. Fields depend on type.",
      "additionalProperties": true,
      "properties": {
        "label":          { "type": "string" },
        "min":            { "type": "number" },
        "max":            { "type": "number" },
        "unit":           { "type": "string" },
        "format":         { "type": "string", "description": "printf-style format, e.g. '%.2f'" },
        "decimals":       { "type": "integer", "minimum": 0, "description": "Decimal places. Found in existing projects; not read by either app yet" },
        "thresholds":     { "type": "array", "items": { "$ref": "#/$defs/Threshold" } },
        "momentary":      { "type": "boolean", "description": "Button: true=momentary, false=toggle" },
        "onValue":        { "description": "Button on-press value" },
        "offValue":       { "description": "Button off/release value" },
        "trueColor":      { "type": "string", "description": "LED color when true" },
        "falseColor":     { "type": "string", "description": "LED color when false" },
        "trueLabel":      { "type": "string", "description": "LED text when true" },
        "falseLabel":     { "type": "string", "description": "LED text when false" },
        "duration":       { "type": "integer", "description": "Trend history window in seconds" },
        "xFormat":        { "$ref": "#/$defs/TrendXFormat" },
        "tags":           { "type": "array", "items": { "$ref": "#/$defs/TrendSeries" }, "description": "Trend multi-series config" },
        "refLines":       { "type": "array", "items": { "$ref": "#/$defs/RefLine" }, "description": "Trend horizontal reference lines" },
        "pageSize":       { "type": "integer", "description": "HistoryLog rows per page" },
        "step":           { "type": "number", "description": "Setpoint slider step" },
        "states":         { "type": "array", "items": { "$ref": "#/$defs/StateEntry" }, "description": "MultiState value→label→color map" },
        "maxRows":        { "type": "integer", "description": "AlarmBanner max visible rows" },
        "showAcked":      { "type": "boolean", "description": "AlarmBanner: show acknowledged alarms" },
        "action":         { "$ref": "#/$defs/ButtonAction" },
        "navigateTo":     { "type": "string", "description": "Button navigate: target page id" },
        "btnColor":       { "$ref": "#/$defs/ButtonColor" },
        "btnVariant":     { "$ref": "#/$defs/ButtonVariant" },
        "btnRounded":     { "$ref": "#/$defs/ButtonRounded" },
        "icon":           { "type": "string", "description": "Button icon (emoji or short text)" },
        "toggleOnColor":  { "type": "string", "description": "Toggle button color when on" },
        "toggleOffColor": { "type": "string", "description": "Toggle button color when off" },
        "src":            { "type": "string", "description": "Image: data-URL, URL or 'lib:<imageId>'" },
        "fit":            { "$ref": "#/$defs/ImageFit", "description": "Image object-fit, as set by the properties panel" },
        "objectFit":      { "$ref": "#/$defs/ImageFit", "description": "Image object-fit, as set when dropped from the image library" },
        "symbolId":       { "type": "string", "description": "Symbol: id from a symbol pack" },
        "stroke":         { "type": "string", "description": "Symbol: stroke color" },
        "colorBinding":   { "type": "string", "description": "Tag path for color threshold evaluation" },
        "colorThresholds":{ "type": "array", "items": { "$ref": "#/$defs/Threshold" }, "description": "Color threshold rules applied to colorBinding" },
        "staticText":     { "type": "string", "description": "TextDisplay: fixed text shown instead of a tag value" },
        "placeholder":    { "type": "string", "description": "TextInput/NumericInput placeholder" },
        "textAlign":      { "$ref": "#/$defs/TextAlign" },
        "textColor":      { "type": "string" },
        "bgColor":        { "type": "string" },
        "borderColor":    { "type": "string" },
        "noPadding":      { "type": "boolean" },
        "fontFamily":     { "type": "string", "description": "mono | sans | serif; empty means the theme font" },
        "fontSize":       { "type": "string", "description": "xs | sm | base | lg | xl | 2xl | 3xl | 4xl; empty means base" },
        "fontBold":       { "type": "boolean" },
        "fontItalic":     { "type": "boolean" },
        "fontUnderline":  { "type": "boolean" },
        "faceplateId":    { "type": "string", "description": "Faceplate widget: id of the faceplate to show" },
        "params":         { "type": "object", "additionalProperties": { "type": "string" }, "description": "Faceplate widget: parameter name → binding" },
        "rows":           { "type": "array", "items": { "$ref": "#/$defs/TableRow" }, "description": "Table widget rows" },
        "showQuality":    { "type": "boolean", "description": "Show the tag quality indicator" }
      }
    },
    "TrendXFormat": {
      "title": "TrendXFormat",
      "type": "string",
      "enum": ["time", "time-short", "relative", "datetime"],
      "description": "Trend X-axis label format"
    },
    "ButtonAction": {
      "title": "ButtonAction",
      "type": "string",
      "enum": ["write", "navigate"]
    },
    "ButtonColor": {
      "title": "ButtonColor",
      "type": "string",
      "enum": ["blue", "green", "red", "amber", "zinc", "purple", "orange", "white"]
    },
    "ButtonVariant": {
      "title": "ButtonVariant",
      "type": "string",
      "enum": ["filled", "outlined", "ghost", "flat", "industrial"]
    },
    "ButtonRounded": {
      "title": "ButtonRounded",
      "type": "string",
      "enum": ["none", "sm", "md", "lg", "full"]
    },
    "ImageFit": {
      "title": "ImageFit",
      "type": "string",
      "enum": ["contain", "cover", "fill"]
    },
    "TextAlign": {
      "title": "TextAlign",
      "type": "string",
      "enum": ["left", "center", "right"]
    },
    "Threshold": {
      "title": "Threshold",
      "type": "object",
      "required": ["value", "color"],
      "additionalProperties": false,
      "properties": {
        "value":   { "type": "number" },
        "toValue": { "type": "number", "description": "Optional upper bound (exclusive). If set, matches value >= value && value < toValue. If missing, matches value >= value (open-ended, highest match wins)" },
        "color":   { "type": "string", "description": "CSS color, e.g. '#22c55e'" }
      }
    },
    "TrendSeries": {
      "title": "TrendSeries",
      "type": "object",
      "required": ["binding", "color"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string" },
        "color":   { "type": "string" },
        "label":   { "type": "string" },
        "fill":    { "type": "boolean" },
        "yMin":    { "type": "number" },
        "yMax":    { "type": "number" }
      }
    },
    "RefLine": {
      "title": "RefLine",
      "type": "object",
      "required": ["value", "color"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "color": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "StateEntry": {
      "title": "StateEntry",
      "type": "object",
      "required": ["value", "label", "color"],
      "additionalProperties": false,
      "properties": {
        "value":     {},
        "label":     { "type": "string" },
        "color":     { "type": "string" },
        "textColor": { "type": "string" }
      }
    },
    "TableRow": {
      "title": "TableRow",
      "type": "object",
      "required": ["label", "binding"],
      "additionalProperties": false,
      "properties": {
        "label":   { "type": "string" },
        "binding": { "type": "string" },
        "unit":    { "type": "string" }
      }
    },
    "Dynamic": {
      "title": "Dynamic",
      "type": "object",
      "description": "A dynamic behavior on a widget. Which fields apply depends on kind",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id":            { "type": "string" },
        "kind":          { "$ref": "#/$defs/DynamicKind" },
        "binding":       { "type": "string", "description": "Tag the dynamic reacts to" },
        "trueColor":     { "type": "string", "description": "colorFill: color when the tag is truthy" },
        "falseColor":    { "type": "string", "description": "colorFill: color when the tag is falsy" },
        "blinkPeriodMs": { "type": "integer", "description": "blink: period in milliseconds" },
        "blinkColor":    { "type": "string", "description": "blink: flash color" },
        "minValue":      { "type": "number", "description": "rotation: tag value mapped to minAngle" },
        "maxValue":      { "type": "number", "description": "rotation: tag value mapped to maxAngle" },
        "minAngle":      { "type": "number", "description": "rotation: angle in degrees" },
        "maxAngle":      { "type": "number", "description": "rotation: angle in degrees" },
        "actionType":    { "$ref": "#/$defs/DynamicActionType" },
        "writeTo":       { "type": "string", "description": "Action: binding to write to (may differ from binding)" },
        "writeValue":    { "description": "writeValue action: value to write" },
        "step":          { "type": "number", "description": "incrementValue action: amount to add" },
        "pageId":        { "type": "string", "description": "navigate action: target page id" },
        "url":           { "type": "string", "description": "openUrl action: URL to open" },
        "expression":    { "type": "string", "description": "script: expression evaluated with `value` = tag value, e.g. 'value > 5000'" },
        "targetProp":    { "$ref": "#/$defs/DynamicTargetProp" },
        "trueValue":     { "type": "string", "description": "script: applied to targetProp when the expression is truthy" },
        "falseValue":    { "type": "string", "description": "script: applied to targetProp when the expression is falsy" }
      }
    },
    "DynamicKind": {
      "title": "DynamicKind",
      "type": "string",
      "enum": ["visibility", "colorFill", "blink", "rotation", "disable", "onClick", "onPressed", "onReleased", "script"]
    },
    "DynamicActionType": {
      "title": "DynamicActionType",
      "type": "string",
      "enum": ["writeValue", "toggleValue", "incrementValue", "navigate", "openUrl"]
    },
    "DynamicTargetProp": {
      "title": "DynamicTargetProp",
      "type": "string",
      "enum": ["bgColor", "borderColor", "textColor", "visible"]
    },
    "AlarmRule": {
      "title": "AlarmRule",
      "type": "object",
      "required": ["id", "name", "binding", "condition", "threshold", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "id":        { "type": "string" },
        "name":      { "type": "string" },
        "binding":   { "type": "string", "description": "datasource_id:tag_path, e.g. 'opcua:ns=2;s=PLCnext.pressure'" },
        "condition": { "$ref": "#/$defs/AlarmCondition" },
        "threshold": { "type": "number" },
        "severity":  { "$ref": "#/$defs/AlarmSeverity" },
        "message":   { "type": "string" }
      }
    },
    "AlarmCondition": {
      "title": "AlarmCondition",
      "type": "string",
      "enum": ["gt", "gte", "lt", "lte", "eq", "ne"]
    },
    "AlarmSeverity": {
      "title": "AlarmSeverity",
      "type": "string",
      "enum": ["critical", "warning", "info"]
    },
    "Recipe": {
      "title": "Recipe",
      "type": "object",
      "required": ["id", "name", "entries"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "description": { "type": "string" },
        "entries":     { "type": "array", "items": { "$ref": "#/$defs/RecipeEntry" } }
      }
    },
    "RecipeEntry": {
      "title": "RecipeEntry",
      "type": "object",
      "required": ["binding", "value"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "description": "datasource_id:tag_path" },
        "value":   {}
      }
    },
    "NamespaceNode": {
      "title": "NamespaceNode",
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": false,
      "properties": {
        "path":        { "type": "string", "description": "Dot-separated path, e.g. 'plant.pump1.running'" },
        "type":        { "$ref": "#/$defs/NamespaceNodeType" },
        "dataType":    { "type": "string", "description": "float | bool | string | int" },
        "description": { "type": "string" },
        "unit":        { "type": "string" },
        "driverId":    { "type": "string", "description": "Datasource id the tag comes from" },
        "driverAddr":  { "type": "string", "description": "Raw driver address of the tag" },
        "expression":  { "type": "string", "description": "virtual nodes: formula" },
        "meta":        { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "NamespaceNodeType": {
      "title": "NamespaceNodeType",
      "type": "string",
      "enum": ["folder", "asset", "tag", "virtual"]
    },
    "Faceplate": {
      "title": "Faceplate",
      "type": "object",
      "required": ["id", "name", "params", "widgets"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "description": { "type": "string" },
        "params":      { "type": "array", "items": { "$ref": "#/$defs/FaceplateParam" } },
        "widgets":     { "type": "array", "items": { "$ref": "#/$defs/FaceplateWidget" } }
      }
    },
    "FaceplateParam": {
      "title": "FaceplateParam",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "description": "Used as {name} in bindings inside the faceplate" },
        "description": { "type": "string" }
      }
    },
    "FaceplateWidget": {
      "title": "FaceplateWidget",
      "type": "object",
      "description": "A widget inside a faceplate. Same as Widget, but identified by localId",
      "required": ["localId", "type", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "localId":        { "type": "string" },
        "type":           { "$ref": "#/$defs/WidgetType" },
        "x":              { "type": "integer", "minimum": 0 },
        "y":              { "type": "integer", "minimum": 0 },
        "w":              { "type": "integer", "minimum": 1 },
        "h":              { "type": "integer", "minimum": 1 },
        "binding":        { "type": "string", "description": "May contain {param} placeholders" },
        "visibleBinding": { "type": "string" },
        "locked":         { "type": "boolean" },
        "groupId":        { "type": "string" },
        "config":         { "$ref": "#/$defs/WidgetConfig" },
        "dynamics":       { "type": "array", "items": { "$ref": "#/$defs/Dynamic" } }
      }
    },
    "ImageAsset": {
      "title": "ImageAsset",
      "type": "object",
      "required": ["id", "name", "dataUrl", "mimeType", "width", "height", "size"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string" },
        "name":     { "type": "string" },
        "dataUrl":  { "type": "string", "description": "base64 data URL" },
        "mimeType": { "type": "string" },
        "width":    { "type": "integer" },
        "height":   { "type": "integer" },
        "size":     { "type": "integer", "description": "Original file size in bytes" }
      }
    },
    "UDT": {
      "title": "UDT",
      "type": "object",
      "required": ["id", "name", "fields"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "description": { "type": "string" },
        "fields":      { "type": "array", "items": { "$ref": "#/$defs/UDTField" } }
      }
    },
    "UDTField": {
      "title": "UDTField",
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string" },
        "type":        { "$ref": "#/$defs/UDTFieldType" },
        "unit":        { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "UDTFieldType": {
      "title": "UDTFieldType",
      "type": "string",
      "enum": ["bool", "int", "real", "string"]
    },
    "AssetNode": {
      "title": "AssetNode",
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "parentId":    { "type": "string" },
        "description": { "type": "string" },
        "tagPrefix":   { "type": "string" },
        "udtId":       { "type": "string" },
        "iconType":    { "$ref": "#/$defs/AssetIconType" }
      }
    },
    "AssetIconType": {
      "title": "AssetIconType",
      "type": "string",
      "enum": ["plant", "area", "unit", "device", "sensor"]
    },
    "CanvasResolution": {
      "title": "CanvasResolution",
      "type": "object",
      "description": "Screen size. 'dynamic' fills the browser window; 'fixed' uses width and height in pixels",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":   { "$ref": "#/$defs/CanvasResolutionType" },
